{
  "schema_version": 1,
  "id": "racer",
  "name": "Racer",
  "version": "0.1.0",
  "description": "Plan and analyze synchronized repeated or multi-endpoint race tests without mislabeling ordinary concurrency as single-packet delivery.",
  "enabled": true,
  "entrypoint": "index.js",
  "entrypoint_sha256": "493a315a1b0e1a6c178dd8cb1cdf52bc9a90c0d3a285b13a85348c366a92ec1e",
  "capabilities": ["http.race"],
  "limits": { "timeout_ms": 900000, "max_operations": 21, "max_concurrency": 1, "memory_mb": 32 },
  "actions": [{
    "name": "run",
    "description": "Compare a sequential control with repeated synchronized attempts across one or more saved request shapes.",
    "required_capabilities": ["http.race"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_state_changes"],
      "properties": {
        "allow_state_changes": { "const": true, "description": "Acknowledge that the selected requests can execute multiple state changes." },
        "exchange_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "description": "Optional multi-endpoint request shapes; omit to repeat the base exchange." },
        "pattern": { "enum": ["limit_overrun", "multi_endpoint", "object_state", "partial_construction", "time_sensitive", "deferred"], "default": "limit_overrun" },
        "technique": { "enum": ["parallel", "last_byte_sync", "h2_single_packet"], "default": "last_byte_sync" },
        "copies": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Copies per request shape; defaults to 20 for one shape and 1 for multiple shapes." },
        "attempts": { "type": "integer", "minimum": 2, "maximum": 20, "default": 3 },
        "expected_max_successes": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
        "success_statuses": { "type": "array", "maxItems": 20, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 },
        "hold_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 15000, "default": 5000 }
      }
    }
  }]
}
