{
  "schema_version": 1,
  "id": "racer",
  "name": "Racer",
  "version": "0.5.0",
  "description": "Run bounded same-request or multi-endpoint race groups with private setup-response extraction, per-attempt inline templates, semantic predicates, HTTP/1 last-byte synchronization, and real HTTP/2 single-packet release.",
  "enabled": true,
  "entrypoint": "index.js",
  "entrypoint_sha256": "f34505f5ba053b96bd5b1ea21012763d65f7442c69ae4145e94f871d3fddb48b",
  "capabilities": ["http.race"],
  "limits": { "timeout_ms": 900000, "max_operations": 2000, "max_concurrency": 1, "memory_mb": 32 },
  "actions": [{
    "name": "run",
    "description": "Run sequential, parallel, exact HTTP/1 final-byte, or real HTTP/2 single-packet request groups using saved or unsent request shapes.",
    "required_capabilities": ["http.race"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_state_changes"],
      "$defs": {
        "text_predicate": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "equals": { "type": "string" },
            "contains": { "type": "string" },
            "regex": { "type": "string" }
          }
        },
        "success_predicate": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "status_codes": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
            "headers": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "equals": { "type": "string" },
                  "contains": { "type": "string" },
                  "regex": { "type": "string" }
                },
                "anyOf": [{ "required": ["equals"] }, { "required": ["contains"] }, { "required": ["regex"] }]
              }
            },
            "body_contains": { "type": "string" },
            "body_regex": { "type": "string" },
            "json": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pointer"],
                "properties": {
                  "pointer": { "type": "string", "pattern": "^($|/)" },
                  "equals": {},
                  "exists": { "type": "boolean" }
                }
              }
            },
            "redirect_location": { "$ref": "#/$defs/text_predicate" }
          }
        },
        "extract_rule": {
          "oneOf": [{
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "name", "pattern"],
            "properties": {
              "from": { "const": "body_regex" },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
              "pattern": { "type": "string", "maxLength": 2048 },
              "group": { "type": "integer", "minimum": 0, "default": 1 },
              "encoding": { "enum": ["raw", "url", "json", "base64"], "default": "raw" },
              "required": { "type": "boolean", "default": true }
            }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "name", "header"],
            "properties": {
              "from": { "const": "header" },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
              "header": { "type": "string", "minLength": 1, "maxLength": 256 },
              "encoding": { "enum": ["raw", "url", "json", "base64"], "default": "raw" },
              "required": { "type": "boolean", "default": true }
            }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "name", "pointer"],
            "properties": {
              "from": { "const": "json" },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
              "pointer": { "type": "string", "pattern": "^($|/)" },
              "encoding": { "enum": ["raw", "url", "json", "base64"], "default": "raw" },
              "required": { "type": "boolean", "default": true }
            }
          }]
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 80 },
            "base_exchange_id": { "type": "integer", "minimum": 1 },
            "method": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https?://" },
            "headers": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": { "name": { "type": "string" }, "value": { "type": "string" } } } },
            "header_tombstones": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
            "body_text": { "type": "string" },
            "body_base64": { "type": "string" },
            "protocol": { "enum": ["auto", "h1", "h2"], "default": "auto" },
            "use_project_cookies": { "type": "boolean", "default": true, "description": "Apply the scoped project cookie jar, including to inline HTTP/1 last-byte templates." },
            "copies": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
            "success": { "$ref": "#/$defs/success_predicate" },
            "extract": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/extract_rule" }, "description": "Setup requests only: privately extract bounded response values for later typed {{extract:name}} placeholders." }
          },
          "anyOf": [{ "required": ["base_exchange_id"] }, { "required": ["url"] }],
          "not": { "required": ["body_text", "body_base64"] }
        }
      },
      "properties": {
        "allow_state_changes": { "const": true, "description": "Acknowledge that selected, setup, and validation requests may change server state." },
        "requests": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/request" }, "description": "Saved or unsent request shapes. {attempt} and setup-produced {{extract:name}} placeholders are replaced only in URL, body_text, and header values." },
        "setup_requests": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/request" }, "description": "Sequential setup/reset requests run before the control and every attempt. Response extracts are private, bounded, and unique per attempt." },
        "validation_requests": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/request" }, "description": "Sequential post-attempt checks with typed {attempt} and {{extract:name}} substitution; all must match for an attempt to qualify." },
        "success": { "$ref": "#/$defs/success_predicate", "description": "Default semantic success predicate for race requests." },
        "setup_success": { "$ref": "#/$defs/success_predicate" },
        "validation_success": { "$ref": "#/$defs/success_predicate" },
        "exchange_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "description": "Legacy saved shapes used when requests is omitted." },
        "pattern": { "enum": ["limit_overrun", "multi_endpoint", "object_state", "partial_construction", "time_sensitive", "deferred"], "default": "limit_overrun" },
        "technique": { "enum": ["sequential", "parallel", "last_byte_sync", "h2_single_packet"], "default": "last_byte_sync" },
        "control_mode": { "enum": ["none", "single_each", "full_group"], "default": "single_each", "description": "Use none for one-shot transitions, single_each for a low-impact benchmark, or full_group for legacy comparison." },
        "copies": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Legacy copies per exchange_id." },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
        "expected_max_successes": { "type": "integer", "minimum": 0, "maximum": 100, "default": 1 },
        "success_statuses": { "type": "array", "maxItems": 20, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "uniqueItems": true, "description": "Legacy fallback only; semantic success predicates are recommended." },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 },
        "hold_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 15000, "default": 5000 }
      }
    }
  }]
}
