{
  "schema_version": 1, "id": "upload-analyzer", "name": "UploadAnalyzer", "version": "1.3.4",
  "description": "Compare inert allowed and prohibited upload controls against a bounded filename-normalization and content-validation matrix.",
  "enabled": true, "entrypoint": "index.js", "entrypoint_sha256": "d42e0b358c8cc375c3837aaa0644b7c671fc5bd473c8d544b9b3ace4016fa990",
  "capabilities": ["http.semantic", "identity.use"],
  "limits": { "timeout_ms": 900000, "max_operations": 48, "max_concurrency": 2, "memory_mb": 64, "js_stage_timeout_ms": 60000 },
  "actions": [{ "name": "scan", "description": "Mutate the first multipart file part after explicit confirmation that repeated uploads are authorized.", "required_capabilities": ["http.semantic", "identity.use"], "requires_base_exchange": true,
    "input_schema": { "type": "object", "additionalProperties": false, "required": ["allow_uploads"], "properties": {
      "allow_uploads": { "const": true },
      "marker": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,40}$", "default": "huntproxy-upload" },
      "allowed_extension": { "type": "string", "pattern": "^\\.?[A-Za-z0-9]{1,12}$", "default": "txt" },
      "prohibited_extension": { "type": "string", "pattern": "^\\.?[A-Za-z0-9]{1,12}$", "default": "php" },
      "expect_content_validation": { "type": "boolean", "default": false },
      "allow_server_config_uploads": { "type": "boolean", "default": false, "description": "Explicitly opt into the sequential inert .htaccess and alternate-extension validation chain." },
      "server_config_extension": { "type": "string", "pattern": "^\\.?[A-Za-z0-9]{1,12}$", "default": "l33t" },
      "safe_readback_url": { "type": "string", "maxLength": 4096, "description": "In-scope URL for the inert alternate-extension file; {filename} is replaced with the generated filename." },
      "success_markers": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "failure_markers": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
      "max_files": { "type": "integer", "minimum": 2, "maximum": 21, "default": 21 }
    } }
  }]
}
