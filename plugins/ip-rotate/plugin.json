{
  "schema_version": 1,
  "id": "ip-rotate",
  "name": "IpRotate",
  "version": "1.1.0",
  "description": "Enable and disable project-level AWS API Gateway IP rotation for an exact target origin.",
  "enabled": true,
  "entrypoint": "index.js",
  "entrypoint_sha256": "3721e998b5abb7fd3997b8ce6f67c7e744d436639ff6efda43dad5eeb2441f81",
  "resources": { "aws-control": { "path": "resources/aws-control.py", "sha256": "29d7457a58811fa0bd0d8b1b5dbeae751e307551edc7cc2891cf503d6ceef7e2" } },
  "capabilities": ["aws.api_gateway"],
  "limits": { "timeout_ms": 900000, "max_operations": 30, "max_concurrency": 1, "memory_mb": 16 },
  "actions": [
    {
      "name": "enable",
      "description": "Provision regional gateways and automatically rotate matching project traffic until disabled. Credentials come from ip-rotate/aws-credentials.toml.",
      "required_capabilities": ["aws.api_gateway"],
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["target_url", "regions"],
        "properties": {
          "target_url": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^/?#]+/?$", "description": "Exact HTTP(S) target origin, for example https://api.example.com." },
          "regions": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+-[0-9]+$", "maxLength": 32 } },
          "stage_name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$", "default": "huntproxy" }
        }
      }
    },
    {
      "name": "status",
      "description": "List enabled and cleanup-pending IP rotation profiles for this project.",
      "required_capabilities": ["aws.api_gateway"],
      "input_schema": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    {
      "name": "disable",
      "description": "Immediately stop rotating the exact target origin, then delete its HuntProxy-managed API Gateways.",
      "required_capabilities": ["aws.api_gateway"],
      "input_schema": {
        "type": "object", "additionalProperties": false, "required": ["target_url"],
        "properties": { "target_url": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^/?#]+/?$" } }
      }
    }
  ]
}
