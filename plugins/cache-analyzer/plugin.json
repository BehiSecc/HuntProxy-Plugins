{
  "schema_version": 1,
  "id": "cache-analyzer",
  "name": "CacheAnalyzer",
  "version": "0.2.0",
  "description": "Test cache-key discrepancies, cache poisoning, and web cache deception with cache-busted controls and confirmation.",
  "enabled": true,
  "entrypoint": "index.js",
  "entrypoint_sha256": "4807ad3206d80645863efc8fe1865da2964016e85ab3cf4dd161d37d04f0dcf7",
  "resources": {
    "headers": { "path": "resources/headers", "sha256": "175619d3e49c28431b4ced6363ba63544771db298834195fd3ccb3fc422e9af7" }
  },
  "capabilities": ["http.semantic"],
  "limits": { "timeout_ms": 900000, "max_operations": 2000, "max_concurrency": 1, "memory_mb": 64 },
  "actions": [{
    "name": "scan",
    "description": "Probe one saved request for poisoning and deception behaviors, requiring clean-control confirmation.",
    "required_capabilities": ["http.semantic"],
    "input_schema": { "type": "object", "additionalProperties": false, "required": ["marker", "allow_cache_side_effects"], "properties": {
      "marker": { "type": "string", "pattern": "^[A-Za-z0-9]{8,40}$", "description": "Unique per-run marker generated by the caller." },
      "allow_cache_side_effects": { "const": true, "description": "Explicit acknowledgement that the test may create isolated cache entries." },
      "modes": { "type": "array", "uniqueItems": true, "items": { "enum": ["poisoning", "deception"] } },
      "headers": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": "Additional candidate header names or Param Miner-style name~value templates." },
      "use_header_wordlist": { "type": "boolean", "default": true },
      "max_header_candidates": { "type": "integer", "minimum": 1, "maximum": 500, "default": 300 },
      "max_poison_variants": { "type": "integer", "minimum": 1, "maximum": 504, "default": 304 },
      "static_extensions": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9]{1,12}$" }, "default": ["js", "css", "ico"] },
      "path_delimiters": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 12 }, "description": "Literal or percent-encoded delimiters to test before a static-looking suffix." },
      "max_deception_variants": { "type": "integer", "minimum": 1, "maximum": 100, "default": 40 }
    } }
  }]
}
